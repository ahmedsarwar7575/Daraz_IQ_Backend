# Application
NODE_ENV=development
PORT=4000
# Production: set this to https://daraz-mcp-backend.onrender.com
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=generate-a-long-random-value
SESSION_EXPIRES_IN=1d
OAUTH_STATE_SECRET=generate-another-long-random-value
TOKEN_ENCRYPTION_KEY=generate-a-separate-long-random-value

# OAuth for Claude/ChatGPT MCP connectors
OAUTH_ISSUER=http://localhost:4000
OAUTH_CODE_TTL_MINUTES=10
MCP_RESOURCE_URL=http://localhost:4000/api/mcp
MCP_ACCESS_TOKEN_EXPIRES_IN=7d
MCP_REFRESH_TOKEN_EXPIRES_IN=90d

# PostgreSQL (use DATABASE_URL, or the individual DB values below)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=daraz_console
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_SSL=false
DB_SYNC=true

# Google Identity Services
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Nodemailer SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=Daraz Console <your-email@gmail.com>

# Daraz Open Platform
DARAZ_APP_KEY=your-daraz-app-key
DARAZ_APP_SECRET=your-daraz-app-secret
DARAZ_AUTH_URL=https://api.daraz.pk/oauth/authorize
DARAZ_SYSTEM_API_URL=https://api.daraz.pk/rest
# Optional marketplace override, for example https://api.daraz.pk/rest
DARAZ_API_URL=https://api.daraz.pk/rest
# Must exactly match the callback URL saved in your Daraz app.
DARAZ_REDIRECT_URI=http://localhost:4000/api/daraz/callback

# Copilot competitor benchmarking
COMPETITOR_CACHE_TTL_HOURS=6
COMPETITOR_LIVE_SCRAPE_ENABLED=false
COMPETITOR_SCRAPE_MAX_PAGES=1

# OpenAI reasoning layer
AI_PROVIDER=openrouter
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter reasoning layer
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=SellerDesk
